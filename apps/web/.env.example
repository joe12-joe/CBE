# Copy to .env.local and fill in. When both VITE_ vars are set the app uses
# the live Supabase backend; otherwise it falls back to the in-memory mock DB.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Used ONLY by scripts/setup-supabase.mjs (schema/seed + demo accounts).
# Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=